{
  "name": "scalargalaxy-cli",
  "version": "0.2.0",
  "description": "The Scalar Galaxy is an example OpenAPI document to test OpenAPI tools and libraries. It's a fictional universe with fictional planets and fictional data.",
  "author": "Scalar Galaxy",
  "type": "module",
  "bin": {
    "scalargalaxy": "./dist/esm/bin.js"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "api.md",
    "man",
    "SKILL.md"
  ],
  "man": [
    "./man/scalargalaxy.1",
    "./man/scalargalaxy-planets-list-all-data.1",
    "./man/scalargalaxy-planets-create.1",
    "./man/scalargalaxy-planets-retrieve.1",
    "./man/scalargalaxy-planets-update.1",
    "./man/scalargalaxy-planets-delete.1",
    "./man/scalargalaxy-planets-delte-image.1",
    "./man/scalargalaxy-celestial-bodies-create.1",
    "./man/scalargalaxy-authentication-create-user.1",
    "./man/scalargalaxy-authentication-create-token.1",
    "./man/scalargalaxy-authentication-list-me.1",
    "./man/scalargalaxy-completion.1"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/finalize-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cjs.json --noEmit"
  },
  "dependencies": {
    "ansis": "^4.3.0",
    "commander": "^14.0.3",
    "yaml": "^2.9.0",
    "standardwebhooks": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^6.0.0"
  },
  "license": "Apache-2.0"
}
